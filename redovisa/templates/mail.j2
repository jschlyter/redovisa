<html>
<head>
<style>
th {
    font-family: Franklin Gothic Medium,Franklin Gothic,ITC Franklin Gothic,Arial,sans-serif;
    text-align: left;
}

th.amount, td.amount {
    text-align: right;
}
</style>
</head>
<body>

<h1>Utlägg från {{ expense_report.recipient.name }}</h1>

<p>Referensnummer {{ expense_report.id }}</p>

<h2>Mottagare</h2>

<p><table>
  <tr>
    <th>Namn</th>
    <td>{{ expense_report.recipient.name }}</td>
  </tr>
  <tr>
    <th>Epost</th>
    <td>{{ expense_report.recipient.email }}</td>
  </tr>
{% if expense_report.total_amount > 0 %}
  <tr>
    <th>Kontonummer</th>
    <td>{{ expense_report.recipient.account or "" }}</td>
  </tr>
{% else %}
  <tr>
    <th>Kontonummer</th>
    <td><i>Återbetalning via Swish</i></td>
  </tr>
{% endif %}
  <tr>
    <th>Datum</th>
    <td>{{ expense_report.date }}</td>
  </tr>
  <tr>
{% if expense_report.total_amount > 0 %}
    <th>Totalsumma att betala ut</th>
    <td>{{ "%0.2f" | format(expense_report.total_amount | float) }} kr</td>
{% else %}
    <th>Totalsumma att betala in</th>
    <td>{{ "%0.2f" | format(- expense_report.total_amount | float) }} kr</td>
{% endif %}
  </tr>
</table></p>


<h2>Poster</h2>

<p><table>
  <tr>
    <th>Konto</th>
    <th>Namn</th>
    <th>Beskrivning</th>
    <th class="amount">Belopp</th>
  </tr>

{% for item in expense_report.items %}
  <tr>
    <td>{{ item.account }}</td>
    <td>{{ item.account_name }}</td>
    <td>{{ item.description }}</td>
    <td  class="amount">{{ "%0.2f" | format(item.amount | float) }} kr</td>
  </tr>
{% endfor %}

</table></p>

</body>
</html>
